# CloudSentinel
CLOUDSENTINEL_SECRET_KEY=replace-with-random-secret
CLOUDSENTINEL_SERVICE_KEY=replace-with-strong-random-service-key
BOOKSTREAM_BACKEND_URL=http://127.0.0.1:5001
CS_ADMIN_EMAIL=admin@example.com
CS_MAIL_USERNAME=
CS_MAIL_PASSWORD=
BOOKSTREAM_USER_OTP_VALID_SECONDS=120
BOOKSTREAM_ADMIN_OTP_VALID_SECONDS=600
BOOKSTREAM_OTP_RESEND_SECONDS=120
BOOKSTREAM_OTP_MAX_RESENDS=3

# BookStream backend
# Copy these to BookStream/backend/.env
MONGODB_URI=mongodb://127.0.0.1:27017/bookstream
JWT_SECRET=replace-with-random-jwt-secret
PORT=5001
CLOUDSENTINEL_URL=http://127.0.0.1:8000
CLOUDSENTINEL_SERVICE_KEY=replace-with-the-same-service-key
